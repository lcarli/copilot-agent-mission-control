    "@mission-control/event-contracts": "workspace:*",
    "@mission-control/event-management": "workspace:*",
    "@mission-control/hint-system": "workspace:*",
    "@mission-control/mission-management": "workspace:*",
    "@mission-control/scoring": "workspace:*",
    "@mission-control/validation-worker": "workspace:*",
