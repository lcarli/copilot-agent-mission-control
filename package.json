{
  "name": "copilot-agent-mission-control",
  "version": "0.0.0",
  "private": true,
  "description": "Mission-based, multilingual workshops for building GitHub Copilot agents in VS Code.",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm exec turbo run build",
    "build:local": "pnpm --filter @mission-control/api... --filter @mission-control/participant-cli... --workspace-concurrency=1 exec tsc -p tsconfig.build.json",
    "start:local": "pnpm --filter @mission-control/api start:local",
    "test:workshop": "pnpm run build:local && pnpm --filter @mission-control/tests-e2e test",
    "test:workshop:load": "pnpm run build:local && pnpm --filter @mission-control/tests-load test",
    "deploy:azure": "pwsh -NoProfile -File scripts/deploy.ps1",
    "destroy:azure": "pwsh -NoProfile -File scripts/destroy.ps1",
    "dev": "pnpm exec turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm exec turbo run lint",
    "preflight:participant": "pwsh -NoProfile -File scripts/participant-preflight.ps1",
    "test": "pnpm exec turbo run test",
    "typecheck": "pnpm exec turbo run typecheck",
    "validate:infra": "pwsh -NoProfile -File scripts/validate-infra.ps1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
