{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/localization.schema.json",
  "title": "Campaign localization resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "campaignId",
    "campaignVersion",
    "locale",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "localization"
    },
    "campaignId": {
      "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/kebabId"
    },
    "campaignVersion": {
      "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/semanticVersion"
    },
    "locale": {
      "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/locale"
    },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/localizationKey"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://github.com/lcarli/copilot-agent-mission-control/schemas/campaign/v1/common.schema.json#/$defs/localizationKey"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "placeholders": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "maximumLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    }
  }
}
