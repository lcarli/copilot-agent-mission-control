{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "severity",
    "location",
    "affectedServices",
    "missingInformation"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["flooding", "medical", "power", "transport", "communications"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "location": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "affectedServices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "missingInformation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "severityExplanation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "duplicateOf": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
