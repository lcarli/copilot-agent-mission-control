{
  "name": "@mission-control/campaign-operation-lighthouse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "media",
    "starters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mission-control/localization": "workspace:*",
    "@mission-control/validation-worker": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/validate-assets.mjs && node scripts/validate-starters.mjs",
    "lint": "eslint src test",
    "test": "vitest run && node scripts/validate-starters.mjs",
    "validate:assets": "tsc -p tsconfig.build.json && node scripts/validate-assets.mjs",
    "typecheck": "tsc -p tsconfig.json"
  }
}
